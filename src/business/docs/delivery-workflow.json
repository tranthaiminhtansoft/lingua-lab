  "cards": [
    {
      "dot": "cyan",
      "title": "Workflow-level view",
      "items": [
        "Each node is one workflow file; internal jobs and steps are intentionally omitted.",
        "The release and recovery workflows call the same reusable Pages deployment workflow."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure hand-off",
      "items": [
        "PRD Release dispatches PRD Rollback only after a deployed candidate fails post-deployment verification.",
        "The separate rollback sequence shows the recovery steps and its approval gate."
      ]
    },
    {
      "dot": "cyan",
      "title": "Workflow entry points",
      "items": [
        "Developer opens or updates a PR to master; GitHub emits the pull_request event and automatically starts CI when changed paths match its allowlist.",
        "Releaser manually dispatches the release-branch workflow; it is not connected to PR CI."
      ]
    }
